# Settings for `python -m ledger`. Every one is optional.
#
#   cp .env.example .env
#
# The CLI reads .env from the directory you run it in (or the nearest parent).
# Variables already set in your shell win over this file.
# Never commit .env: it can hold the PII keys.

# SQLite database file. Defaults to ./ledger.db.
LEDGER_DB=ledger.db

# PII keys. Leave both unset to use the key file created beside a new database
# (<db>.keys.json). Set them only for a NEW database: an existing database refuses
# keys other than the ones it was created with.
# Make each key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# LEDGER_MATCH_KEY=
# LEDGER_ENC_KEY=
